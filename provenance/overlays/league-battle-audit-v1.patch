diff --git a/scripts/rnad/league-battle-audit.mjs b/scripts/rnad/league-battle-audit.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ba1440bceba7216f13a41b8c733ed085995ef61c
--- /dev/null
+++ b/scripts/rnad/league-battle-audit.mjs
@@ -0,0 +1,79 @@
+// The audit never feeds policy selection, the learner, or handoff.
+function compactState(view) {
+  return {
+    active:view.self.active,
+    team:view.self.team.map(({speciesId,hp,maxHP,status,boosts})=>
+      ({speciesId,hp,maxHP,status,boosts})),
+    opponent:view.opponent,field:view.field
+  };
+}
+
+export function newLeagueAudit({maxRows=16000,maxBytes=8*1024*1024}={}) {
+  const rows=[];
+  const decisions=new Map();
+  let bytes=0, seen=0, dropped=0, accepted=0, omittedDraftCandidates=0;
+  function add(kind, fields) {
+    const sequence=++seen;
+    if(rows.length>=maxRows){dropped++;return;}
+    const row={sequence,kind,...fields};
+    const size=Buffer.byteLength(JSON.stringify(row))+1;
+    if(bytes+size>maxBytes){dropped++;return;}
+    bytes+=size;
+    rows.push(row);
+  }
+  return {
+    fact:(kind,round,turn,request,fields)=>add(kind,{round,turn,request,...fields}),
+    outcome(round,seat,before,after){
+      add('post-submit',{round,seat,turn:before.turn,request:before.request,
+        nextRequest:after.request,state:compactState(after)});
+    },
+    accepted({index,seat,round,stage,action,observation,request,publicFoe,roster}){
+      const actionOrdinal=accepted++;
+      add('accepted',{index,seat,round,stage,action,actionOrdinal,
+        ...(stage==='battle'?{turn:observation.turn,requestType:observation.requestType,
+          request,state:{own:observation.self,opponent:publicFoe,field:observation.field}}
+          :{roster})});
+      if(rows.at(-1)?.sequence===seen)decisions.set(actionOrdinal,rows.at(-1));
+    },
+    policy(ordinal,candidates,p){
+      if(typeof candidates==='number')omittedDraftCandidates+=candidates;
+      const row=decisions.get(ordinal);
+      if(!row)return;
+      if(typeof candidates==='number'){
+        row.candidateCount=candidates;return;
+      }
+      if(!Array.isArray(candidates)||p.policy_pi.length!==candidates.length||
+        JSON.stringify(candidates[p.index])!==JSON.stringify(row.action))
+        throw Error('Audit candidate order differs from recorded policy');
+      row.candidates=candidates;
+      row.policy=p.policy_pi;
+      row.behaviorProbability=p.behavior_prob;
+      row.predictedValue=p.predicted_value;
+    },
+    finish(match,meta){
+      if(accepted!==match.events.length)throw Error('Audit and accepted trajectory diverged');
+      // The completed rows (including policy scores) must also respect byte limit.
+      let total=0,keep=0;
+      for(const row of rows){
+        total+=Buffer.byteLength(JSON.stringify(row))+1;
+        if(total>maxBytes)break;
+        keep++;
+      }
+      dropped+=rows.length-keep;
+      rows.length=keep;
+      return {
+        schema:'rnad-league-battle-audit-v1',
+        sourceSha:match.source_sha,engineSha:match.engine_sha,
+        auditSha:process.env.RNAD_AUDIT_SHA??null,
+        runId:process.env.GITHUB_RUN_ID??null,runAttempt:process.env.GITHUB_RUN_ATTEMPT??null,
+        generation:meta.generation,actorId:meta.actor_id,role:meta.role,
+        matchId:match.match_id,seed:match.seed,learnerSeat:match.learner_seat,
+        modelSha:match.main_sha256,magnetSha:match.magnet_sha256,
+        opponentSha:match.opponent_sha256,
+        winner:match.winner,score:match.score,rounds:match.rounds,
+        coverage:{seen,recorded:rows.length,dropped,accepted,omittedDraftCandidates},
+        rows
+      };
+    }
+  };
+}
diff --git a/scripts/rnad/pack_league_battle_audit.py b/scripts/rnad/pack_league_battle_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..528f8118ef5cd5272a7c281c092b998be20bd4d3
--- /dev/null
+++ b/scripts/rnad/pack_league_battle_audit.py
@@ -0,0 +1,87 @@
+"""Verify diagnostic files against completed, accepted Actor matches."""
+import argparse
+from collections import Counter
+import gzip
+import hashlib
+import json
+from pathlib import Path
+
+
+def pack(accepted_dir, audit_dir, output):
+    accepted_dir, audit_dir, output = map(Path, (accepted_dir, audit_dir, output))
+    accepted = sorted(accepted_dir.glob("*.json.gz"))
+    if len(accepted) not in (2, 64):
+        raise ValueError("Expected a completed paired smoke or a full Actor shard")
+    manifest = {"schema": "rnad-league-battle-audit-shard-v1",
+                "expectedMatches": len(accepted), "files": [], "missing": [],
+                "invalid": [], "counts": {}}
+    counts = Counter()
+    unexpected = {p.name for p in audit_dir.glob("*.json.gz")} - {p.name for p in accepted}
+    if unexpected:
+        raise ValueError(f"Unexpected audit files: {sorted(unexpected)}")
+    for source in accepted:
+        dest = audit_dir / source.name
+        if not dest.is_file():
+            manifest["missing"].append(source.name)
+            continue
+        with gzip.open(source, "rt") as stream:
+            match = json.load(stream)
+        try:
+            payload = dest.read_bytes()
+            row = json.loads(gzip.decompress(payload))
+            pairs = (("matchId", "match_id"), ("sourceSha", "source_sha"),
+                     ("engineSha", "engine_sha"), ("modelSha", "main_sha256"),
+                     ("magnetSha", "magnet_sha256"), ("opponentSha", "opponent_sha256"),
+                     ("learnerSeat", "learner_seat"), ("seed", "seed"),
+                     ("winner", "winner"), ("score", "score"), ("rounds", "rounds"))
+            if (row["schema"] != "rnad-league-battle-audit-v1" or
+                any(row[left] != match[right] for left, right in pairs)):
+                raise ValueError("Audit provenance differs from accepted match")
+            cover = row["coverage"]
+            records = row["rows"]
+            if (cover["seen"] != cover["recorded"] + cover["dropped"] or
+                cover["recorded"] != len(records) or
+                cover["accepted"] != len(match["events"]) or
+                any(type(cover[k]) is not int or cover[k] < 0 for k in
+                    ("seen", "recorded", "dropped", "accepted", "omittedDraftCandidates"))):
+                raise ValueError("Inconsistent audit coverage")
+            seq = [r["sequence"] for r in records]
+            if seq != sorted(set(seq)) or any(not 0 < x <= cover["seen"] for x in seq):
+                raise ValueError("Invalid audit sequence")
+            recorded_actions = [r for r in records if r["kind"] == "accepted"]
+            if not cover["dropped"] and len(recorded_actions) != cover["accepted"]:
+                raise ValueError("Missing accepted actions in complete log")
+            for r in recorded_actions:
+                event = match["events"][r["actionOrdinal"]]
+                if (event["actor"] != r["seat"] or event["phase"] != r["stage"] or
+                    ("candidates" in r and (r["policy"] != event["policy_pi"] or
+                     r["candidates"][event["action_index"]] != r["action"]))):
+                    raise ValueError("Different accepted action or policy support")
+        except (OSError, EOFError, ValueError, TypeError, KeyError, IndexError) as exc:
+            manifest["invalid"].append({"file": source.name, "reason": type(exc).__name__})
+            # Keep invalid bytes out of the artifact.
+            continue
+        output.mkdir(parents=True, exist_ok=True)
+        (output / dest.name).write_bytes(payload)
+        manifest["files"].append({"file": dest.name,
+                                  "sha256": hashlib.sha256(payload).hexdigest()})
+        counts.update({k: cover[k] for k in ("seen", "recorded", "dropped", "accepted")})
+        counts.update(r["kind"] for r in records if r["kind"] != "accepted")
+    manifest["counts"] = dict(counts)
+    manifest["recordedMatches"] = len(manifest["files"])
+    output.mkdir(parents=True, exist_ok=True)
+    (output / "coverage.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    print(json.dumps({k: v for k, v in manifest.items() if k != "files"}))
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("accepted_dir")
+    parser.add_argument("audit_dir")
+    parser.add_argument("output")
+    args = parser.parse_args()
+    pack(args.accepted_dir, args.audit_dir, args.output)
+
+
+if __name__ == "__main__":
+    main()
